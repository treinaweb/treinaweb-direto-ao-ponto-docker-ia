# Copie para .env e preencha os valores: cp .env.example .env
# Ambiente para uso local: os usuários de teste têm senha pública.

# --- Obrigatórias: sem elas, o docker compose não sobe ---

# Senha do PostgreSQL. Vale só na criação do volume: para trocá-la depois,
# altere-a no banco ou recrie o volume com docker compose down -v (apaga os dados).
# Gere com: openssl rand -hex 24
POSTGRES_PASSWORD=

# Segredo do access token (JWT).
# Gere com: openssl rand -hex 48
JWT_ACCESS_SECRET=

# Senha do ADMIN criado pelo seed.
# Gere com: openssl rand -hex 16
ADMIN_PASSWORD=

# --- Opcionais: os valores abaixo são os padrões ---

# Usuário e nome do banco. Não use caracteres especiais de URL no usuário ou na senha.
# POSTGRES_USER=postgres
# POSTGRES_DB=treinadesk

# E-mail do ADMIN criado pelo seed.
# ADMIN_EMAIL=admin@treinadesk.local
